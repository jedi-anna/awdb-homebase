# Copy to .env.local for local development. Never commit real values.

# Where the app runs. Must match a redirect URI registered on your Buffer app client.
APP_URL=https://localhost:3000

# Buffer app client (Buffer > Settings > API > App Clients)
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# Any random string of 32+ characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Claude writes the post framing. Without a key, a simple template is used.
ANTHROPIC_API_KEY=
# Photo uploads (Vercel > Storage > Blob creates this). Without it, users paste photo links instead.
BLOB_READ_WRITE_TOKEN=

# Optional model override
CLAUDE_MODEL=claude-sonnet-5-5
